# TETUKO - Teknologi Terpadu Komprehensif (KMP/Desktop)
# Semua konfigurasi terpusat di file ini. Salin ke .env dan sesuaikan bila perlu.
# JANGAN commit file .env yang berisi nilai rahasia/produksi.

# ── Firebase / Firestore (sumber akun login & izin aplikasi, tanpa Firebase Auth) ─
# Wajib minimal: FIREBASE_PROJECT_ID dan FIREBASE_API_KEY (dibaca dari environment proses atau .env)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID
# Opsional (kompatibilitas payload/kredensial terenkripsi bila digunakan oleh data existing)
APP_SECRET=YOUR_APP_SECRET
PAYLOAD_KEY=YOUR_PAYLOAD_KEY

# ── Profil Jatim (Provinsi Jawa Timur) ───────────────────────────────
JATIM_ID=jatim
JATIM_NAME=Provinsi Jawa Timur
JATIM_LABEL=Presensi Jatimprov
JATIM_GATEWAY_URL=
JATIM_EP_BASE_URL=
JATIM_MODE=bkd-rpc
JATIM_REQUIRES_PHOTO=false
JATIM_REQUIRES_WORKCODE=true

# ── Profil Madiun (Kabupaten Madiun) ─────────────────────────────────
MADIUN_ID=madiun
MADIUN_NAME=Kabupaten Madiun
MADIUN_LABEL=Presensi Madiunkab
MADIUN_GATEWAY_URL=
MADIUN_EP_BASE_URL=
MADIUN_MODE=bkd-rpc
MADIUN_REQUIRES_PHOTO=false
MADIUN_REQUIRES_WORKCODE=true

# ── Profil Ponorogo (Kabupaten Ponorogo) ─────────────────────────────
PONOROGO_ID=ponorogo
PONOROGO_NAME=Kabupaten Ponorogo
PONOROGO_LABEL=Presensi Ponorogo
PONOROGO_GATEWAY_URL=
PONOROGO_EP_BASE_URL=
PONOROGO_MODE=ponorogo-absensi
PONOROGO_REQUIRES_PHOTO=true
PONOROGO_REQUIRES_WORKCODE=false
PONOROGO_API_BASE=
PONOROGO_IMAGE_BASE=

# ── Aplikasi / Proxy / OCR ───────────────────────────────────────────
LOCAL_API_PORT=14200
# Allow-list host proxy (SSRF hardening), koma-separated. Wajib diisi via env/secret; kosong = host diturunkan dari endpoint yang dikonfigurasi.
PRESENSI_ALLOWED_HOSTS=
PRESENSI_DEFAULT_GATEWAY_URL=
PRESENSI_DEFAULT_EP_BASE_URL=
# OCR captcha (opsional): kosong = OCR ONNX lokal
TETUKO_OCR_URL=
TETUKO_OCR_MODEL=
TETUKO_OCR_CHARSET=
