# TETUKO KMP — konfigurasi runtime (TANPA prefix VITE_)
# Salin ke .env lokal bila perlu. JANGAN commit .env yang berisi nilai rahasia.
# Build AppImage/tar.gz di CI tidak memerlukan secret custom; konfigurasi ini
# dibaca saat runtime oleh aplikasi desktop (env proses, lalu fallback file .env).

# ── Firebase / Firestore (sumber akun login & izin aplikasi, tanpa Firebase Auth) ─
# Jika FIREBASE_PROJECT_ID dan FIREBASE_API_KEY terisi & terbaca, login/manajemen
# akun memakai data Firestore. Jika tidak, aplikasi fallback ke akun lokal perangkat
# dengan pesan status eksplisit di layar masuk.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Opsional: kompatibilitas payload/kredensial terenkripsi pada data existing
APP_SECRET=
PAYLOAD_KEY=

# ── Proxy allow-list (SSRF hardening) ───────────────────────────────
# Daftar host upstream yang diizinkan, dipisah koma. Wajib diisi via env/secret; kosong = host diturunkan dari endpoint yang dikonfigurasi.
PRESENSI_ALLOWED_HOSTS=

# Gateway BKD default (jika tidak dikirim lewat header/param request)
PRESENSI_DEFAULT_GATEWAY_URL=
PRESENSI_DEFAULT_EP_BASE_URL=

# Endpoint API Ponorogo (opsional; default sudah ada di kode)
PRESENSI_PONOROGO_API_BASE=

# ── Override per profil (request-level, proxy tetap memeriksa allow-list) ──
JATIM_GATEWAY_URL=
JATIM_EP_BASE_URL=
MADIUN_GATEWAY_URL=
MADIUN_EP_BASE_URL=
PONOROGO_GATEWAY_URL=
PONOROGO_EP_BASE_URL=
PONOROGO_API_BASE=
PONOROGO_IMAGE_BASE=

# ── OCR captcha (opsional) ──────────────────────────────────────────
# URL OCR eksternal; bila kosong OCR ONNX lokal dipakai.
TETUKO_OCR_URL=
# Path absolut ke model/charset (bila tidak memakai aset app-resources/ocr)
TETUKO_OCR_MODEL=
TETUKO_OCR_CHARSET=

# ── CI ──────────────────────────────────────────────────────────────
# GITHUB_TOKEN disediakan otomatis oleh Actions; tidak perlu dibuat manual.
# Nilai Firebase/APP_SECRET/PAYLOAD_KEY adalah data runtime (bukan kebutuhan build);
# simpan sebagai GitHub Secrets/Variables bila diperlukan untuk distribusi/lingkungan.
