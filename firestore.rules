rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Login/konfigurasi per akun-profil & auth app (tanpa Firebase Auth, disimpan terenkripsi/hash).
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Akun pengguna aplikasi TETUKO (admin kelola user, user verifikasi login)
    match /tetuko_users/{userId} {
      allow read, write: if true;
    }

    // Cadangan/kompatibilitas.
    match /users/{userId} {
      allow read, write: if true;
    }

    // Tolak akses ke koleksi lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
